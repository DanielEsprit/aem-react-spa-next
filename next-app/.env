# AEM instance the server fetches page models from. Points at the bundled mock AEM by default;
# set to e.g. http://localhost:4502 (in .env.local) to use a real AEM instance.
AEM_HOST=http://localhost:3000/mock-aem
# Server-only: never exposed to the browser (CRA inlined this into the JS bundle).
AEM_AUTHORIZATION_HEADER=Basic YWRtaW46YWRtaW4=
# The page "/" redirects to.
AEM_ROOT=/content/aem-react-spa/us/en/home.html
